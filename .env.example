# Copy to .env and fill values needed for current milestone.
# Never put real credentials in this example file.

# M3: script generation
OPENROUTER_API_KEY=
SCRIPT_PROVIDER=openrouter
SCRIPT_MODEL=deepseek/deepseek-v3.2

# M4: text-to-speech
GEMINI_API_KEY=
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE_A=Kore
TTS_VOICE_B=Puck

# M5: Cloudflare R2 and private RSS
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
FEED_TOKEN=

# M6: failure notifications
ALERT_WEBHOOK_URL=
